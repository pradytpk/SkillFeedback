// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id                    String   @id @default(cuid())
  name                  String
  role                  String
  team                  String
  startDate             DateTime
  avatarColor           String   @default("#ea580c")
  selfAssessmentEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  skillRatings      SkillRating[]
  meetings          Meeting[]
  skillCategories   EmployeeSkillCategory[]
  yearNotes         YearNote[]
  goals             Goal[]
  commitments       Commitment[]
  appraisalRecords  AppraisalRecord[]
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SkillCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())

  skills    Skill[]
  employees EmployeeSkillCategory[]
}

model EmployeeSkillCategory {
  employeeId String
  categoryId String
  assignedAt DateTime @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([employeeId, categoryId])
}

model Skill {
  id           String    @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  isBuiltIn    Boolean   @default(false)
  targetRating Int?
  targetByDate DateTime?
  createdAt    DateTime  @default(now())

  category       SkillCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skillRatings   SkillRating[]
  roleBenchmarks RoleBenchmark[]
  linkedGoals    Goal[]

  @@unique([name, categoryId])
}

model SkillRating {
  id         String   @id @default(cuid())
  employeeId String
  skillId    String
  rating     Int
  selfRating Int?
  ratedBy    String   @default("manager")
  notes      String?
  ratedAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([employeeId, skillId])
  @@index([ratedAt])
}

model Meeting {
  id          String   @id @default(cuid())
  employeeId  String
  meetingDate DateTime
  notes       String?
  feedback    String?
  moodScore   Int?
  qualityFlag String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actionItems ActionItem[]
  commitments Commitment[]
}

model ActionItem {
  id          String    @id @default(cuid())
  meetingId   String
  description String
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model YearNote {
  id         String   @id @default(cuid())
  employeeId String
  yearLabel  String   // e.g. "2024-25" (Apr 2024 – Mar 2025)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, yearLabel])
}

model RoleBenchmark {
  id           String @id @default(cuid())
  role         String
  skillId      String
  targetRating Int

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([role, skillId])
}

model MeetingTemplate {
  id            String   @id @default(cuid())
  title         String   @unique
  notesTemplate String?
  createdAt     DateTime @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  employeeId    String
  title         String
  description   String?
  targetDate    DateTime?
  status        String    @default("ACTIVE")
  category      String?
  fiscalYear    String?
  quarter       String?
  progressPct   Int       @default(0)
  linkedSkillId String?
  weight        Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  linkedSkill Skill?       @relation(fields: [linkedSkillId], references: [id], onDelete: SetNull)
  updates     GoalUpdate[]
}

model GoalUpdate {
  id          String   @id @default(cuid())
  goalId      String
  note        String
  progressPct Int
  updatedAt   DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Commitment {
  id          String    @id @default(cuid())
  employeeId  String
  meetingId   String?
  description String
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  meeting  Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

model AppraisalRecord {
  id                String   @id @default(cuid())
  employeeId        String
  fiscalYear        String
  overallRating     String?
  talentBoxPerf     String?
  talentBoxPot      String?
  achievements      String?
  strengths         String?
  developAreas      String?
  devPlanNextYear   String?
  peerFeedbackNotes String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fiscalYear])
}
